# Copier ce fichier en .env.local puis adapter les valeurs.
# Préfixe NEXT_PUBLIC_ : valeurs utilisées aussi dans le navigateur
# (recherche côté client, tuiles de la carte). Ne jamais y mettre de secret.
# Elles sont figées au moment de `next build`.

# API de recherche de localités (Open-Meteo Geocoding)
NEXT_PUBLIC_GEOCODING_API_URL=https://geocoding-api.open-meteo.com/v1

# API de prévisions (Open-Meteo Forecast)
NEXT_PUBLIC_FORECAST_API_URL=https://api.open-meteo.com/v1/forecast

# Tuiles de la carte OpenStreetMap
NEXT_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# ---------------------------------------------------------------
# Variables SERVEUR uniquement (pas de préfixe NEXT_PUBLIC_) :
# jamais envoyées au navigateur.
# ---------------------------------------------------------------

# URL publique du site (SEO : URLs canoniques).
# Optionnelle sur Vercel : le domaine de production est utilisé automatiquement.
SITE_URL=http://localhost:3000
